@startuml
skinparam linetype ortho
skinparam classAttributeIconSize 0
hide circle

entity "users" {
  * id : BIGINT [PK]
  --
  name : VARCHAR(50)
  surname : VARCHAR(50)
  email : VARCHAR(100) [UNIQUE]
  phone_number : VARCHAR(20) [UNIQUE]
  password : VARCHAR(255)
  profile_picture : MEDIUMBLOB
  role : TINYINT
  status : TINYINT
}

entity "routines" {
  * id : BIGINT [PK]
  --
  name : VARCHAR(100)
  description : TEXT
  creation_date : DATETIME
  modification_date : DATETIME
  trainer_id : BIGINT [FK → users.id]
  visibility : TINYINT
  difficulty : TINYINT
}

entity "exercises" {
  * id : BIGINT [PK]
  --
  name : VARCHAR(100)
  description : TEXT
  muscle_group : VARCHAR(100)
  equipment : VARCHAR(100)
  image : MEDIUMBLOB
  status : VARCHAR(20)
  creator_id : BIGINT [FK → users.id]
}

entity "routine_exercises" {
  * id : BIGINT [PK]
  --
  routine_id : BIGINT [FK → routines.id]
  exercise_id : BIGINT [FK → exercises.id]
  position : INT
}

entity "workouts" {
  * id : BIGINT [PK]
  --
  start_time : DATETIME
  end_time : DATETIME
  routine_id : BIGINT [FK → routines.id]
  user_id : BIGINT [FK → users.id]
}

entity "workout_exercises" {
  * id : BIGINT [PK]
  --
  reps : SMALLINT
  weight : SMALLINT
  duration_seconds : SMALLINT
  workout_id : BIGINT [FK → workouts.id]
  routine_exercise_id : BIGINT [FK → routine_exercises.id]
}

entity "user_follows" {
  * id : BIGINT [PK]
  --
  client_id : BIGINT [FK → users.id]
  trainer_id : BIGINT [FK → users.id]
}

entity "notifications" {
  * id : BIGINT [PK]
  --
  message : TEXT
  user_id : BIGINT [FK → users.id]
  is_read : BOOLEAN
  date : DATETIME
}

entity "routine_likes" {
  * id : BIGINT [PK]
  --
  routine_id : BIGINT [FK → routines.id]
  user_id : BIGINT [FK → users.id]
}

' Relaciones
users ||--o{ routines : trainer_id
users ||--o{ exercises : creator_id
routines ||--o{ routine_exercises : contiene
exercises ||--o{ routine_exercises : pertenece
routines ||--o{ workouts : genera
users ||--o{ workouts : realiza
workouts ||--o{ workout_exercises : incluye
routine_exercises ||--o{ workout_exercises : referencia
users ||--o{ notifications : recibe
users ||--o{ user_follows : client_id
users ||--o{ user_follows : trainer_id
users ||--o{ routine_likes : da_like
routines ||--o{ routine_likes : recibe_like

@enduml
